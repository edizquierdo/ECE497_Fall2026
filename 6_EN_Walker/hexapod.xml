<mujoco model="hexapod">
  <!--
  Six-legged hexapod, revised leg design: each leg is a SINGLE rigid
  segment pivoting at one mount point, with 2 co-located hinge joints at
  that point (zero-length link between them) rather than a hip+knee
  kinematic chain with a separate femur/tibia segment (as in Ant-v5 and
  the first version of this file).

  Why: walker.py's own idealized physics only ever models ONE angle per
  leg -- there's no knee, no second segment. A hip+knee chain (like
  Ant's) is more mechanically realistic for an eventual physical robot,
  but for THIS transfer test it introduces a structural mismatch (1-DOF
  vs 2-DOF leg) that has nothing to do with idealized-vs-real PHYSICS,
  which is the actual thing being tested. This design instead gives each
  leg exactly 2 controllable axes at a single pivot:
    - "sweep" (axis z, like walker.py's leg angle): forward/backward
    - "lift" (axis along the leg's resting direction, perpendicular to
      sweep): up/down

  This maps far more directly onto walker.py's (fwd, bwd, foot) x 6
  action space -- see hexapod_bridge.py's simplified mapping:
    sweep torque = fwd - bwd
    lift torque  = driven by foot (planted vs swinging)
  with no invented knee interpretation and no discarded leg-state
  needed on the observation side either.
  -->
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option integrator="RK4" timestep="0.01"/>
  <default>
    <joint armature="0.5" damping="1" limited="true"/>
    <geom conaffinity="0" condim="3" density="5.0" friction="1 0.5 0.5" margin="0.01" rgba="0.8 0.6 0.4 1"/>
  </default>
  <asset>
    <texture builtin="gradient" height="100" rgb1="1 1 1" rgb2="0 0 0" type="skybox" width="100"/>
    <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom" random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
    <texture builtin="checker" height="100" name="texplane" rgb1="0 0 0" rgb2="0.8 0.8 0.8" type="2d" width="100"/>
    <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" texrepeat="60 60" texture="texplane"/>
    <material name="geom" texture="texgeom" texuniform="true"/>
  </asset>
  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1"/>
    <geom conaffinity="1" condim="3" material="MatPlane" name="floor" pos="0 0 0" rgba="0.8 0.9 0.8 1" size="40 40 40" type="plane"/>

    <body name="torso" pos="0 0 0.16">
      <camera name="track" mode="trackcom" pos="0 -1.2 0.5" xyaxes="1 0 0 0 0 1"/>
      <geom name="torso_geom" type="box" size="0.16 0.09 0.03" rgba="0.6 0.6 0.9 1"/>
      <joint armature="0" damping="0" limited="false" margin="0.01" name="root" pos="0 0 0" type="free"/>

      <!--
      Each leg is ONE body with TWO hinge joints (sweep, then lift) both
      anchored at that body's own origin -- i.e. both DOF pivot at the
      same physical point, not spread across a hip-then-knee chain --
      followed by one capsule geom running outward/down from that point.
      This is the "single pivot, 2 controllable axes" design.
      -->

      <!-- Left side: front, mid, back -->
      <body name="leg_front_left" pos="0.16 0.09 0">
        <joint axis="0 0 1" name="sweep_front_left" pos="0 0 0" range="-45 45" type="hinge"/>
        <joint axis="1 0 0" name="lift_front_left" pos="0 0 0" range="-15 60" type="hinge"/>
        <geom fromto="0.0 0.0 0.0 0.14 0.08 -0.10" name="leg_fl_geom" size="0.02" type="capsule"/>
      </body>

      <body name="leg_mid_left" pos="0.0 0.09 0">
        <joint axis="0 0 1" name="sweep_mid_left" pos="0 0 0" range="-45 45" type="hinge"/>
        <joint axis="1 0 0" name="lift_mid_left" pos="0 0 0" range="-15 60" type="hinge"/>
        <geom fromto="0.0 0.0 0.0 0.0 0.16 -0.10" name="leg_ml_geom" size="0.02" type="capsule"/>
      </body>

      <body name="leg_back_left" pos="-0.16 0.09 0">
        <joint axis="0 0 1" name="sweep_back_left" pos="0 0 0" range="-45 45" type="hinge"/>
        <joint axis="1 0 0" name="lift_back_left" pos="0 0 0" range="-15 60" type="hinge"/>
        <geom fromto="0.0 0.0 0.0 -0.14 0.08 -0.10" name="leg_bl_geom" size="0.02" type="capsule"/>
      </body>

      <!-- Right side: back, mid, front (mirrors walker.py's ordering: legs 3,4,5) -->
      <body name="leg_back_right" pos="-0.16 -0.09 0">
        <joint axis="0 0 1" name="sweep_back_right" pos="0 0 0" range="-45 45" type="hinge"/>
        <joint axis="-1 0 0" name="lift_back_right" pos="0 0 0" range="-15 60" type="hinge"/>
        <geom fromto="0.0 0.0 0.0 -0.14 -0.08 -0.10" name="leg_br_geom" size="0.02" type="capsule"/>
      </body>

      <body name="leg_mid_right" pos="0.0 -0.09 0">
        <joint axis="0 0 1" name="sweep_mid_right" pos="0 0 0" range="-45 45" type="hinge"/>
        <joint axis="-1 0 0" name="lift_mid_right" pos="0 0 0" range="-15 60" type="hinge"/>
        <geom fromto="0.0 0.0 0.0 0.0 -0.16 -0.10" name="leg_mr_geom" size="0.02" type="capsule"/>
      </body>

      <body name="leg_front_right" pos="0.16 -0.09 0">
        <joint axis="0 0 1" name="sweep_front_right" pos="0 0 0" range="-45 45" type="hinge"/>
        <joint axis="-1 0 0" name="lift_front_right" pos="0 0 0" range="-15 60" type="hinge"/>
        <geom fromto="0.0 0.0 0.0 0.14 -0.08 -0.10" name="leg_fr_geom" size="0.02" type="capsule"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Ordered to match walker.py's leg ordering: 0=front_left, 1=mid_left,
         2=back_left, 3=back_right, 4=mid_right, 5=front_right. Each leg
         contributes (sweep, lift) -- 12 actuators total. -->
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="sweep_front_left" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="lift_front_left" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="sweep_mid_left" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="lift_mid_left" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="sweep_back_left" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="lift_back_left" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="sweep_back_right" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="lift_back_right" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="sweep_mid_right" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="lift_mid_right" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="sweep_front_right" gear="15"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" joint="lift_front_right" gear="15"/>
  </actuator>
</mujoco>
